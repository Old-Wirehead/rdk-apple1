digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.38", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#2f6690", penwidth=1.4,
         fontname="Inter", fontsize=10.5, fontcolor="#1c2228", margin="0.14,0.07", height=0.58];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  subgraph cluster_w { label=<<b>Escribir (W)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    cpu1 [label=<<b>6502</b><br/><font point-size="9" color="#5f6a73">cualquier acceso a $C0xx<br/>invierte la salida</font>>];
    ff   [label=<<b>Biestable</b><br/><font point-size="9" color="#5f6a73">1 kHz / 2 kHz<br/>(0 o 1)</font>>];
    out  [label=<<b>Salida</b><br/><font point-size="9" color="#5f6a73">archivo .wav / .aiff<br/>o altavoz</font>>];
    cpu1 -> ff -> out;
  }
  subgraph cluster_r { label=<<b>Leer (R)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    inp  [label=<<b>Entrada de audio</b><br/><font point-size="9" color="#5f6a73">casete, WAV,<br/>smartphone</font>>, fillcolor="#fbf3e2", color="#b9780f"];
    cmp  [label=<<b>Comparador</b><br/><font point-size="9" color="#5f6a73">modelo de entrada:<br/>umbral, histéresis</font>>];
    cpu2 [label=<<b>6502 (PROM de la ACI)</b><br/><font point-size="9" color="#5f6a73">mide los semi-<br/>periodos: bits</font>>];
    inp -> cmp -> cpu2;
  }
}
