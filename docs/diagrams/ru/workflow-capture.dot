digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.42", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#c2531b", penwidth=1.4,
         fontname="Inter", fontsize=11, fontcolor="#1c2228", margin="0.16,0.08", height=0.62];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  tape [label=<<b>Настоящая кассета</b><br/><font point-size="9" color="#5f6a73">магнитофон,<br/>выход на наушники</font>>, fillcolor="#fbf3e2", color="#b9780f"];
  phone [label=<<b>Смартфон</b><br/><font point-size="9" color="#5f6a73">диктофон,<br/>WAV или M4A → WAV</font>>];
  imp [label=<<b>Загрузка</b><br/><font point-size="9" color="#5f6a73">декодирование сигнала,<br/>проверка диапазонов</font>>];
  reco [label=<<b>Распознавание</b><br/><font point-size="9" color="#5f6a73">BASIC или 6502,<br/>адреса, команда запуска</font>>];
  lib [label=<<b>Библиотека</b><br/><font point-size="9" color="#5f6a73">сохранена со своими<br/>параметрами ⚙</font>>];
  tape -> phone -> imp -> reco -> lib;
}
