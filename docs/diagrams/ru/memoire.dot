<tr><td bgcolor="#fbf3e2"><font face="JetBrains Mono">FF00–FFFF</font></td><td bgcolor="#fbf3e2"><b>Woz Monitor</b> (ППЗУ 256 байт)</td><td bgcolor="#fbf3e2">векторы NMI, RESET, IRQ</td></tr>
