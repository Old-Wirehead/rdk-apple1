digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.38", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#2f6690", penwidth=1.4,
         fontname="Inter", fontsize=10.5, fontcolor="#1c2228", margin="0.14,0.07", height=0.58];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  subgraph cluster_w { label=<<b>Scrittura (W)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    cpu1 [label=<<b>6502</b><br/><font point-size="9" color="#5f6a73">ogni accesso a $C0xx<br/>inverte l'uscita</font>>];
    ff   [label=<<b>Flip-flop</b><br/><font point-size="9" color="#5f6a73">1 kHz / 2 kHz<br/>(0 o 1)</font>>];
    out  [label=<<b>Uscita</b><br/><font point-size="9" color="#5f6a73">file .wav / .aiff<br/>o altoparlante</font>>];
    cpu1 -> ff -> out;
  }
  subgraph cluster_r { label=<<b>Lettura (R)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    inp  [label=<<b>Ingresso audio</b><br/><font point-size="9" color="#5f6a73">cassetta, WAV,<br/>smartphone</font>>, fillcolor="#fbf3e2", color="#b9780f"];
    cmp  [label=<<b>Comparatore</b><br/><font point-size="9" color="#5f6a73">modello d'ingresso:<br/>soglia, isteresi</font>>];
    cpu2 [label=<<b>6502 (PROM dell'ACI)</b><br/><font point-size="9" color="#5f6a73">misura i semi-<br/>periodi: bit</font>>];
    inp -> cmp -> cpu2;
  }
}
