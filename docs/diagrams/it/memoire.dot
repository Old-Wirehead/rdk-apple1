<tr><td bgcolor="#fbf3e2"><font face="JetBrains Mono">FF00–FFFF</font></td><td bgcolor="#fbf3e2"><b>Woz Monitor</b> (PROM da 256 byte)</td><td bgcolor="#fbf3e2">vettori NMI, RESET, IRQ</td></tr>
<tr><td bgcolor="#f8f5ef"><font face="JetBrains Mono">E000–EFFF</font></td><td bgcolor="#f8f5ef"><b>Integer BASIC</b> (4 KB di RAM)</td><td bgcolor="#f8f5ef">caricato da cassetta</td></tr>
<tr><td bgcolor="#eef3f7"><font face="JetBrains Mono">D010–D013</font></td><td bgcolor="#eef3f7"><b>PIA 6821</b>: tastiera, schermo</td><td bgcolor="#eef3f7">KBD, KBDCR, DSP, DSPCR</td></tr>
<tr><td bgcolor="#eef3f7"><font face="JetBrains Mono">C250–C257</font></td><td bgcolor="#eef3f7"><b>Scheda GEN2</b>: interruttori</td><td bgcolor="#eef3f7">opzionale, accesso in lettura</td></tr>
