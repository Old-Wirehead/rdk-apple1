<tr><td bgcolor="#edf6ef"><font face="JetBrains Mono">0300–07FF</font></td><td bgcolor="#edf6ef">i vostri programmi in linguaggio macchina</td><td bgcolor="#edf6ef">testo/LORES 1: 0400</td></tr>
<tr><td bgcolor="#f7e9df"><font face="JetBrains Mono">0200–027F</font></td><td bgcolor="#f7e9df">buffer d'ingresso del monitor</td><td bgcolor="#f7e9df">lasciare libero</td></tr>
