digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.42", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#c2531b", penwidth=1.4,
         fontname="Inter", fontsize=11, fontcolor="#1c2228", margin="0.16,0.08", height=0.62];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];

  edit  [label=<<b>Scrivere</b><br/><font point-size="9" color="#5f6a73">editor integrato<br/>colori, errori</font>>];
  run   [label=<<b>Eseguire</b><br/><font point-size="9" color="#5f6a73">pulsante Esegui<br/>E2B3R, poi RUN</font>>];
  dbg   [label=<<b>Debug</b><br/><font point-size="9" color="#5f6a73">punti di interruzione,<br/>variabili, passo singolo</font>>];
  wav   [label=<<b>Esportare</b><br/><font point-size="9" color="#5f6a73">pulsante Esporta WAV<br/>.wav o .aiff</font>>];
  real  [label=<<b>Vero Apple-1</b><br/><font point-size="9" color="#5f6a73">C100R, intervalli,<br/>E2B3R, RUN</font>>, fillcolor="#fbf3e2", color="#b9780f"];

  edit -> run -> wav -> real;
  {rank=same; run; dbg}
  run -> dbg [style=dashed, label="errore?"];
  dbg -> edit [style=dashed, label="correggere"];
}
