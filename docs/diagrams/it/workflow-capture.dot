digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.42", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#c2531b", penwidth=1.4,
         fontname="Inter", fontsize=11, fontcolor="#1c2228", margin="0.16,0.08", height=0.62];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  tape [label=<<b>Cassetta vera</b><br/><font point-size="9" color="#5f6a73">registratore,<br/>uscita cuffie</font>>, fillcolor="#fbf3e2", color="#b9780f"];
  phone [label=<<b>Smartphone</b><br/><font point-size="9" color="#5f6a73">registratore vocale,<br/>WAV o M4A → WAV</font>>];
  imp [label=<<b>Carica</b><br/><font point-size="9" color="#5f6a73">decodifica del segnale,<br/>controllo degli intervalli</font>>];
  reco [label=<<b>Riconoscimento</b><br/><font point-size="9" color="#5f6a73">BASIC o 6502,<br/>indirizzi, comando di avvio</font>>];
  lib [label=<<b>Libreria</b><br/><font point-size="9" color="#5f6a73">archiviato con le sue<br/>impostazioni ⚙</font>>];
  tape -> phone -> imp -> reco -> lib;
}
