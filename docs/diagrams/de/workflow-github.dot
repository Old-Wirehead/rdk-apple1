digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.42", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#c2531b", penwidth=1.4,
         fontname="Inter", fontsize=11, fontcolor="#1c2228", margin="0.16,0.08", height=0.62];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  gh [label=<<b>GitHub-Projekt</b><br/><font point-size="9" color="#5f6a73">+ GitHub-Projekt,<br/>besitzer/repository</font>>];
  test [label=<<b>Neuesten Build testen</b><br/><font point-size="9" color="#5f6a73">lädt die neueste<br/>Fassung des Zweigs</font>>];
  build [label=<<b>Assemblierung</b><br/><font point-size="9" color="#5f6a73">eingebauter Assembler<br/>(ca65 oder xa)</font>>];
  run [label=<<b>Starten</b><br/><font point-size="9" color="#5f6a73">in den Speicher geladen,<br/>dann Adresse R</font>>];
  maj [label=<<b>Aktualisieren</b><br/><font point-size="9" color="#5f6a73">neuer Commit?<br/>von vorn</font>>, style="rounded,dashed,filled"];
  gh -> test -> build -> run;
  run -> maj [style=dashed]; maj -> test [style=dashed];
  {rank=same; run; maj}
}
