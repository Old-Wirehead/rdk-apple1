digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.35", ranksep="0.42", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#c2531b", penwidth=1.4,
         fontname="Inter", fontsize=11, fontcolor="#1c2228", margin="0.16,0.08", height=0.62];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  photo [label=<<b>Photo</b><br/><font point-size="9" color="#5f6a73">jpg, png ou<br/>texte .txt</font>>];
  ascii [label=<<b>Photo → ASCII</b><br/><font point-size="9" color="#5f6a73">cadrage, contraste,<br/>tramage, 40 × 24</font>>];
  code [label=<<b>Programme</b><br/><font point-size="9" color="#5f6a73">BASIC (PRINT)<br/>ou 6502 (ca65)</font>>];
  edit [label=<<b>Éditeur</b><br/><font point-size="9" color="#5f6a73">Insérer dans l’éditeur,<br/>Lancer pour essayer</font>>];
  wav [label=<<b>Exporter WAV</b><br/><font point-size="9" color="#5f6a73">.wav ou .aiff</font>>];
  real [label=<<b>Vrai Apple-1</b><br/><font point-size="9" color="#5f6a73">C100R, plage,<br/>puis R ou RUN</font>>, fillcolor="#fbf3e2", color="#b9780f"];
  lib [label=<<b>Bibliothèque</b><br/><font point-size="9" color="#5f6a73">Enregistrer dans<br/>la bibliothèque</font>>, style="rounded,dashed,filled"];
  photo -> ascii -> code -> edit -> wav -> real;
  ascii -> lib [style=dashed];
}
