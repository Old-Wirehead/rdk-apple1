digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.15", nodesep="0.3", ranksep="0.38", fontname="Inter"];
  node  [shape=box, style="rounded,filled", fillcolor="#f8f5ef", color="#2f6690", penwidth=1.4,
         fontname="Inter", fontsize=10.5, fontcolor="#1c2228", margin="0.14,0.07", height=0.58];
  edge  [color="#5f6a73", penwidth=1.2, arrowsize=0.7, fontname="Inter", fontsize=9, fontcolor="#5f6a73"];
  subgraph cluster_w { label=<<b>Write (W)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    cpu1 [label=<<b>6502</b><br/><font point-size="9" color="#5f6a73">any access to $C0xx<br/>toggles the output</font>>];
    ff   [label=<<b>Flip-flop</b><br/><font point-size="9" color="#5f6a73">1 kHz / 2 kHz<br/>(0 or 1)</font>>];
    out  [label=<<b>Output</b><br/><font point-size="9" color="#5f6a73">.wav / .aiff file<br/>or speaker</font>>];
    cpu1 -> ff -> out;
  }
  subgraph cluster_r { label=<<b>Read (R)</b>>; fontsize=10; color="#d9d4ca"; style="rounded";
    inp  [label=<<b>Audio input</b><br/><font point-size="9" color="#5f6a73">tape, WAV,<br/>smartphone</font>>, fillcolor="#fbf3e2", color="#b9780f"];
    cmp  [label=<<b>Comparator</b><br/><font point-size="9" color="#5f6a73">input model:<br/>threshold, hysteresis</font>>];
    cpu2 [label=<<b>6502 (ACI PROM)</b><br/><font point-size="9" color="#5f6a73">times the half-<br/>periods: bits</font>>];
    inp -> cmp -> cpu2;
  }
}
