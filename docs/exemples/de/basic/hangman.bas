10 REM GALGENMAENNCHEN - CLAUDE IA - 2026
20 DIM W$(12),G$(20),U$(30),A$(26),K(12)
30 A$="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
40 PRINT:PRINT "******* GALGENMAENNCHEN *******"
50 PRINT "ERRATE DAS WORT BUCHSTABENWEISE."
60 PRINT "NACH 7 FEHLERN HAENGST DU!"
70 GOSUB 2000
80 L=LEN(W$):E=0:U$=""
90 FOR I=1 TO L:K(I)=0:NEXT I
100 PRINT:F=0:PRINT "WORT: ";
110 FOR I=1 TO L
120 IF K(I) THEN PRINT W$(I,I);" ";
130 IF K(I)=0 THEN PRINT "- ";
140 IF K(I)=0 THEN F=F+1
150 NEXT I:PRINT
160 IF F=0 THEN 500
170 GOSUB 600
180 IF E>6 THEN 550
190 IF LEN(U$)>0 THEN PRINT "SCHON VERSUCHT: ";U$
200 INPUT "EIN BUCHSTABE",G$
210 IF LEN(G$)#1 THEN 200
220 FOR J=1 TO 26:IF A$(J,J)=G$ THEN 240:NEXT J
230 PRINT "TIPPE EINEN BUCHSTABEN VON A BIS Z.":GOTO 200
240 J=26:NEXT J
250 IF LEN(U$)=0 THEN 280
260 FOR J=1 TO LEN(U$):IF U$(J,J)=G$ THEN 275:NEXT J
270 GOTO 280
275 J=LEN(U$):NEXT J:PRINT "DIESEN BUCHSTABEN HATTEST DU SCHON!":GOTO 100
280 U$(LEN(U$)+1)=G$
290 H=0:FOR I=1 TO L
300 IF W$(I,I)=G$ THEN K(I)=1
310 IF W$(I,I)=G$ THEN H=1
320 NEXT I
330 IF H THEN PRINT "RICHTIG!"
340 IF H=0 THEN E=E+1
350 IF H=0 THEN PRINT "DANEBEN!"
360 GOTO 100
500 PRINT "BRAVO! DAS WORT IST ";W$
510 PRINT "MIT ";E;" FEHLER(N)."
520 GOTO 900
550 PRINT "GEHAENGT! DAS WORT WAR ";W$
560 GOTO 900
600 REM DEN GALGEN ZEICHNEN
610 PRINT
620 IF E<3 THEN PRINT
630 IF E>2 THEN PRINT "  +---+"
640 IF E<2 THEN PRINT
650 IF E=2 OR E=3 THEN PRINT "  !"
660 IF E>3 THEN PRINT "  !   O"
670 IF E<2 THEN PRINT
680 IF E>1 AND E<5 THEN PRINT "  !"
690 IF E=5 THEN PRINT "  !   !"
700 IF E>5 THEN PRINT "  !  /!\"
710 IF E<2 THEN PRINT
720 IF E>1 AND E<7 THEN PRINT "  !"
730 IF E>6 THEN PRINT "  !  / \"
740 IF E=0 THEN PRINT
750 IF E>0 THEN PRINT "======"
760 PRINT "FEHLER: ";E;"/7"
770 RETURN
900 PRINT
910 INPUT "NOCH EINMAL (J/N)",G$
920 IF G$="J" THEN 70
930 PRINT "TSCHUESS!"
940 END
