10 REM STREICHHOELZER (NIM) - CLAUDE IA - 2026
20 DIM R$(5)
30 PRINT:PRINT "******* STREICHHOELZER ********"
40 PRINT "ES GIBT 21 HOELZER. ABWECHSELND NIMMT"
50 PRINT "JEDER 1, 2 ODER 3. WER DAS LETZTE"
60 PRINT "NIMMT, VERLIERT!"
70 N=21:V=0
80 INPUT "WILLST DU ANFANGEN (J/N)",R$
90 IF R$="N" THEN 300
100 REM ZUG DES SPIELERS
110 GOSUB 500
120 INPUT "WIE VIELE NIMMST DU",P
