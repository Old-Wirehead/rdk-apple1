370 IF N=0 THEN 450
380 GOTO 100
400 PRINT:PRINT "DU HAST DAS LETZTE: VERLOREN!"
410 GOTO 600
450 PRINT:PRINT "ICH HABE DAS LETZTE: GEWONNEN!"
460 GOTO 600
500 REM DIE HOELZER ZEICHNEN
510 PRINT
520 FOR I=1 TO N:PRINT "*";:NEXT I
530 PRINT
540 FOR I=1 TO N:PRINT "I";:NEXT I
545 PRINT
550 FOR I=1 TO N:PRINT "I";:NEXT I
555 PRINT
560 PRINT N;" HOELZER UEBRIG."
570 RETURN
600 PRINT
610 INPUT "NOCH EINMAL (J/N)",R$
620 IF R$="J" THEN 70
630 PRINT "TSCHUESS!"
640 END
