10 REM SCHIFFE VERSENKEN - CLAUDE IA - 2026
20 DIM G(64),Q(3),L$(8),N$(8),T$(10),R$(5),M$(30)
30 L$="ABCDEFGH":N$="12345678"
40 PRINT:PRINT "****** SCHIFFE VERSENKEN ******"
50 PRINT "3 SCHIFFE SIND IM GITTER VERSTECKT:"
60 PRINT "EINES MIT 4 FELDERN, 3 UND 2."
70 PRINT "VERSENKE SIE MIT UNTER 40 SCHUESSEN."
80 PRINT "SCHIESSE MIT BUCHSTABE UND ZIFFER."
90 INPUT "RETURN ZUM STARTEN",R$
100 FOR I=1 TO 64:G(I)=0:NEXT I
110 GOSUB 1000
120 H=0:T=0:W=0:M$=""
200 IF T=40 AND H<9 THEN 750
205 GOSUB 500
210 IF H=9 THEN 700
300 INPUT "DEIN SCHUSS (Z.B. C4)",T$
310 IF LEN(T$)#2 THEN 390
320 R=0:FOR J=1 TO 8:IF L$(J,J)=T$(1,1) THEN R=J:NEXT J
330 C=0:FOR J=1 TO 8:IF N$(J,J)=T$(2,2) THEN C=J:NEXT J
340 IF R=0 OR C=0 THEN 390
350 P=(R-1)*8+C:V=G(P)
360 IF V>3 THEN M$="DORT SCHON GESCHOSSEN!"
370 IF V>3 THEN 205
380 GOTO 400
390 M$="EIN BUCHSTABE A-H, DANN 1-8.":GOTO 205
400 T=T+1
410 IF V=0 THEN 600
420 G(P)=4:H=H+1:Q(V)=Q(V)-1:M$="TREFFER!"
440 IF Q(V)=0 THEN M$="TREFFER! ... UND VERSENKT!"
460 GOTO 200
500 REM BILDSCHIRM LEEREN, GITTER ZEICHNEN, DANN LETZTE MELDUNG
505 FOR I=1 TO 24:PRINT:NEXT I
507 PRINT "****** SCHIFFE VERSENKEN ******"
510 PRINT:PRINT "    1 2 3 4 5 6 7 8";
520 IF T>0 THEN PRINT "     SCHUESSE: ";T;
530 PRINT
540 FOR R=1 TO 8:PRINT " ";L$(R,R);"  ";
550 FOR C=1 TO 8:V=G((R-1)*8+C)
560 IF V=0 THEN PRINT ". ";
570 IF V>0 AND V<4 AND W=0 THEN PRINT ". ";
580 IF V>0 AND V<4 AND W=1 THEN PRINT "# ";
590 IF V=4 THEN PRINT "X ";
595 IF V=5 THEN PRINT "O ";
596 NEXT C:PRINT:NEXT R
597 IF LEN(M$) THEN PRINT M$
598 M$="":RETURN
600 G(P)=5:M$="PLATSCH, DANEBEN.":GOTO 200
700 PRINT:PRINT "BRAVO! FLOTTE VERSENKT IN ";T;" SCHUESSEN."
710 GOTO 800
750 W=1:GOSUB 500
760 PRINT "KEINE MUNITION! DIE # ZEIGEN DIE SCHIFFE"
770 PRINT "DIE DU NICHT VERSENKT HAST."
800 PRINT
810 INPUT "NOCH EIN SPIEL (J/N)",R$
820 IF R$="J" THEN 100
830 PRINT "TSCHUESS!"
840 END
1000 REM SCHIFFE SETZEN (4, 3 UND 2 FELDER)
1010 FOR S=1 TO 3
1020 Z=5-S:Q(S)=Z
1030 IF RND(2)=0 THEN 1060
1040 D=8:R=RND(9-Z):C=RND(8)
1050 GOTO 1070
1060 D=1:R=RND(8):C=RND(9-Z)
1070 P=R*8+C+1:O=0
1080 FOR K=0 TO Z-1:O=O+G(P+K*D):NEXT K
1090 IF O THEN 1030
1100 FOR K=0 TO Z-1:G(P+K*D)=S:NEXT K
1110 NEXT S
1120 RETURN
