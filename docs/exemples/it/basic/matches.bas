10 REM FIAMMIFERI (NIM) - CLAUDE IA - 2026
20 DIM R$(5)
30 PRINT:PRINT "********** FIAMMIFERI *********"
40 PRINT "CI SONO 21 FIAMMIFERI. A TURNO, OGNI"
50 PRINT "GIOCATORE NE PRENDE 1, 2 O 3. CHI"
60 PRINT "PRENDE L'ULTIMO PERDE!"
70 N=21:V=0
80 INPUT "VUOI COMINCIARE (S/N)",R$
90 IF R$="N" THEN 300
100 REM TURNO DEL GIOCATORE
110 GOSUB 500
120 INPUT "QUANTI NE PRENDI",P
130 IF P<1 OR P>3 THEN 160
140 IF P>N THEN 170
150 GOTO 200
160 PRINT "SOLO 1, 2 O 3.":GOTO 120
170 PRINT "NE RESTANO SOLO ";N;"!":GOTO 120
200 N=N-P
210 IF N=0 THEN 400
300 REM TURNO DEL COMPUTER
310 GOSUB 500
320 C=(N-1) MOD 4
330 IF C=0 THEN C=RND(3)+1
340 IF C>N THEN C=N
350 PRINT "NE PRENDO ";C;"."
360 N=N-C
370 IF N=0 THEN 450
380 GOTO 100
400 PRINT:PRINT "HAI PRESO L'ULTIMO: HAI PERSO!"
410 GOTO 600
450 PRINT:PRINT "HO PRESO L'ULTIMO: HAI VINTO!"
460 GOTO 600
500 REM DISEGNARE I FIAMMIFERI
510 PRINT
520 FOR I=1 TO N:PRINT "*";:NEXT I
530 PRINT
540 FOR I=1 TO N:PRINT "I";:NEXT I
545 PRINT
550 FOR I=1 TO N:PRINT "I";:NEXT I
555 PRINT
560 PRINT N;" FIAMMIFERO(I) RESTANO."
570 RETURN
600 PRINT
610 INPUT "ANCORA (S/N)",R$
620 IF R$="S" THEN 70
630 PRINT "CIAO!"
640 END
