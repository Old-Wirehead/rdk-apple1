10 REM BATALHA NAVAL - CLAUDE IA - 2026
20 DIM G(64),Q(3),L$(8),N$(8),T$(10),R$(5),M$(30)
30 L$="ABCDEFGH":N$="12345678"
40 PRINT:PRINT "******** BATALHA NAVAL ********"
50 PRINT "HA 3 NAVIOS ESCONDIDOS NA GRELHA:"
60 PRINT "UM DE 4 CASAS, UM DE 3, UM DE 2."
70 PRINT "AFUNDA-OS EM MENOS DE 40 TIROS."
80 PRINT "DISPARA COM UMA LETRA E UM ALGARISMO."
90 INPUT "CARREGA EM RETURN PARA COMECAR",R$
100 FOR I=1 TO 64:G(I)=0:NEXT I
110 GOSUB 1000
120 H=0:T=0:W=0:M$=""
200 IF T=40 AND H<9 THEN 750
205 GOSUB 500
210 IF H=9 THEN 700
300 INPUT "O TEU TIRO (EX: C4)",T$
310 IF LEN(T$)#2 THEN 390
320 R=0:FOR J=1 TO 8:IF L$(J,J)=T$(1,1) THEN R=J:NEXT J
330 C=0:FOR J=1 TO 8:IF N$(J,J)=T$(2,2) THEN C=J:NEXT J
340 IF R=0 OR C=0 THEN 390
350 P=(R-1)*8+C:V=G(P)
360 IF V>3 THEN M$="JA DISPARASTE AI!"
370 IF V>3 THEN 205
380 GOTO 400
390 M$="UMA LETRA A-H E UM ALGARISMO 1-8.":GOTO 205
400 T=T+1
410 IF V=0 THEN 600
420 G(P)=4:H=H+1:Q(V)=Q(V)-1:M$="ACERTASTE!"
440 IF Q(V)=0 THEN M$="ACERTASTE! ... E AFUNDADO!"
460 GOTO 200
500 REM LIMPAR O ECRA, DESENHAR A GRELHA E DEPOIS A ULTIMA MENSAGEM
505 FOR I=1 TO 24:PRINT:NEXT I
507 PRINT "******** BATALHA NAVAL ********"
510 PRINT:PRINT "    1 2 3 4 5 6 7 8";
520 IF T>0 THEN PRINT "     TIROS: ";T;
530 PRINT
540 FOR R=1 TO 8:PRINT " ";L$(R,R);"  ";
550 FOR C=1 TO 8:V=G((R-1)*8+C)
560 IF V=0 THEN PRINT ". ";
570 IF V>0 AND V<4 AND W=0 THEN PRINT ". ";
580 IF V>0 AND V<4 AND W=1 THEN PRINT "# ";
590 IF V=4 THEN PRINT "X ";
595 IF V=5 THEN PRINT "O ";
596 NEXT C:PRINT:NEXT R
597 IF LEN(M$) THEN PRINT M$
598 M$="":RETURN
600 G(P)=5:M$="AGUA, FALHASTE.":GOTO 200
700 PRINT:PRINT "BOA! FROTA AFUNDADA EM ";T;" TIROS."
710 GOTO 800
750 W=1:GOSUB 500
760 PRINT "SEM MUNICOES! OS # SAO OS NAVIOS"
770 PRINT "QUE NAO AFUNDASTE."
800 PRINT
810 INPUT "OUTRO JOGO (S/N)",R$
820 IF R$="S" THEN 100
830 PRINT "ADEUS!"
840 END
1000 REM COLOCAR OS NAVIOS (4, 3 E 2 CASAS)
1010 FOR S=1 TO 3
1020 Z=5-S:Q(S)=Z
1030 IF RND(2)=0 THEN 1060
1040 D=8:R=RND(9-Z):C=RND(8)
1050 GOTO 1070
1060 D=1:R=RND(8):C=RND(9-Z)
1070 P=R*8+C+1:O=0
1080 FOR K=0 TO Z-1:O=O+G(P+K*D):NEXT K
1090 IF O THEN 1030
1100 FOR K=0 TO Z-1:G(P+K*D)=S:NEXT K
1110 NEXT S
1120 RETURN
