10 REM FORCA - CLAUDE IA - 2026
20 DIM W$(12),G$(20),U$(30),A$(26),K(12)
30 A$="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
40 PRINT:PRINT "************ FORCA ************"
50 PRINT "ADIVINHA A PALAVRA, LETRA A LETRA."
60 PRINT "AO 7.O ERRO, ESTAS ENFORCADO!"
70 GOSUB 2000
80 L=LEN(W$):E=0:U$=""
90 FOR I=1 TO L:K(I)=0:NEXT I
100 PRINT:F=0:PRINT "PALAVRA: ";
110 FOR I=1 TO L
120 IF K(I) THEN PRINT W$(I,I);" ";
130 IF K(I)=0 THEN PRINT "- ";
140 IF K(I)=0 THEN F=F+1
150 NEXT I:PRINT
160 IF F=0 THEN 500
170 GOSUB 600
180 IF E>6 THEN 550
190 IF LEN(U$)>0 THEN PRINT "JA TENTADAS: ";U$
200 INPUT "UMA LETRA",G$
210 IF LEN(G$)#1 THEN 200
220 FOR J=1 TO 26:IF A$(J,J)=G$ THEN 240:NEXT J
230 PRINT "ESCREVE UMA LETRA DE A A Z.":GOTO 200
240 J=26:NEXT J
250 IF LEN(U$)=0 THEN 280
260 FOR J=1 TO LEN(U$):IF U$(J,J)=G$ THEN 275:NEXT J
270 GOTO 280
275 J=LEN(U$):NEXT J:PRINT "JA TENTASTE ESSA LETRA!":GOTO 100
280 U$(LEN(U$)+1)=G$
290 H=0:FOR I=1 TO L
300 IF W$(I,I)=G$ THEN K(I)=1
310 IF W$(I,I)=G$ THEN H=1
320 NEXT I
330 IF H THEN PRINT "ACERTASTE!"
340 IF H=0 THEN E=E+1
350 IF H=0 THEN PRINT "FALHASTE!"
360 GOTO 100
500 PRINT "BOA! A PALAVRA E ";W$
510 PRINT "COM ";E;" ERRO(S)."
520 GOTO 900
550 PRINT "ENFORCADO! A PALAVRA ERA ";W$
560 GOTO 900
600 REM DESENHAR A FORCA
610 PRINT
620 IF E<3 THEN PRINT
630 IF E>2 THEN PRINT "  +---+"
640 IF E<2 THEN PRINT
650 IF E=2 OR E=3 THEN PRINT "  !"
660 IF E>3 THEN PRINT "  !   O"
670 IF E<2 THEN PRINT
680 IF E>1 AND E<5 THEN PRINT "  !"
690 IF E=5 THEN PRINT "  !   !"
700 IF E>5 THEN PRINT "  !  /!\"
710 IF E<2 THEN PRINT
720 IF E>1 AND E<7 THEN PRINT "  !"
730 IF E>6 THEN PRINT "  !  / \"
740 IF E=0 THEN PRINT
750 IF E>0 THEN PRINT "======"
760 PRINT "ERROS: ";E;"/7"
770 RETURN
900 PRINT
910 INPUT "OUTRA VEZ (S/N)",G$
920 IF G$="S" THEN 70
930 PRINT "ADEUS!"
940 END
