10 REM FOSFOROS (NIM) - CLAUDE IA - 2026
20 DIM R$(5)
30 PRINT:PRINT "*********** FOSFOROS **********"
40 PRINT "HA 21 FOSFOROS. A VEZ, CADA"
50 PRINT "JOGADOR TIRA 1, 2 OU 3. QUEM TIRAR"
60 PRINT "O ULTIMO PERDE!"
70 N=21:V=0
80 INPUT "QUERES COMECAR (S/N)",R$
90 IF R$="N" THEN 300
100 REM VEZ DO JOGADOR
110 GOSUB 500
120 INPUT "QUANTOS TIRAS",P
130 IF P<1 OR P>3 THEN 160
140 IF P>N THEN 170
150 GOTO 200
160 PRINT "SO 1, 2 OU 3.":GOTO 120
170 PRINT "SO RESTAM ";N;"!":GOTO 120
200 N=N-P
210 IF N=0 THEN 400
300 REM VEZ DO COMPUTADOR
310 GOSUB 500
320 C=(N-1) MOD 4
330 IF C=0 THEN C=RND(3)+1
340 IF C>N THEN C=N
350 PRINT "TIRO ";C;"."
360 N=N-C
370 IF N=0 THEN 450
380 GOTO 100
400 PRINT:PRINT "TIRASTE O ULTIMO: PERDESTE!"
410 GOTO 600
450 PRINT:PRINT "TIREI O ULTIMO: GANHASTE!"
460 GOTO 600
500 REM DESENHAR OS FOSFOROS
510 PRINT
520 FOR I=1 TO N:PRINT "*";:NEXT I
530 PRINT
540 FOR I=1 TO N:PRINT "I";:NEXT I
545 PRINT
550 FOR I=1 TO N:PRINT "I";:NEXT I
555 PRINT
560 PRINT N;" FOSFORO(S) RESTAM."
570 RETURN
600 PRINT
610 INPUT "OUTRA VEZ (S/N)",R$
620 IF R$="S" THEN 70
630 PRINT "ADEUS!"
640 END
