10 REM CERILLAS (NIM) - CLAUDE IA - 2026
20 DIM R$(5)
30 PRINT:PRINT "*********** CERILLAS **********"
40 PRINT "HAY 21 CERILLAS. POR TURNOS, CADA"
50 PRINT "JUGADOR TOMA 1, 2 O 3. QUIEN TOME"
60 PRINT "LA ULTIMA, PIERDE!"
70 N=21:V=0
80 INPUT "QUIERES EMPEZAR (S/N)",R$
90 IF R$="N" THEN 300
100 REM TURNO DEL JUGADOR
110 GOSUB 500
120 INPUT "CUANTAS TOMAS",P
130 IF P<1 OR P>3 THEN 160
140 IF P>N THEN 170
150 GOTO 200
160 PRINT "SOLO 1, 2 O 3.":GOTO 120
170 PRINT "SOLO QUEDAN ";N;"!":GOTO 120
200 N=N-P
210 IF N=0 THEN 400
300 REM TURNO DEL ORDENADOR
310 GOSUB 500
320 C=(N-1) MOD 4
330 IF C=0 THEN C=RND(3)+1
340 IF C>N THEN C=N
350 PRINT "TOMO ";C;"."
360 N=N-C
370 IF N=0 THEN 450
380 GOTO 100
400 PRINT:PRINT "TOMASTE LA ULTIMA: PIERDES!"
410 GOTO 600
450 PRINT:PRINT "TOME LA ULTIMA: GANAS TU!"
460 GOTO 600
500 REM DIBUJAR LAS CERILLAS
510 PRINT
520 FOR I=1 TO N:PRINT "*";:NEXT I
530 PRINT
540 FOR I=1 TO N:PRINT "I";:NEXT I
545 PRINT
550 FOR I=1 TO N:PRINT "I";:NEXT I
555 PRINT
560 PRINT N;" CERILLA(S) QUEDAN."
570 RETURN
600 PRINT
610 INPUT "OTRA VEZ (S/N)",R$
620 IF R$="S" THEN 70
630 PRINT "ADIOS!"
640 END
