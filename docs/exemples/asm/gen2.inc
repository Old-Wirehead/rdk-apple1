; gen2.inc — commutateurs de la carte couleur GEN2 d'Uncle Bernie
; (les $C050-$C057 de l'Apple II, déplacés en $C25x ; une LECTURE commute)
SS_GR    = $C250        ; graphique (quitte le mode texte)
SS_TEXT  = $C251        ; texte
SS_FULL  = $C252        ; plein écran
SS_MIX   = $C253        ; 4 lignes de texte en bas
SS_PAGE1 = $C254
SS_PAGE2 = $C255
SS_LORES = $C256
SS_HIRES = $C257
